# Database Configuration
# Optional: Set DATABASE_URL to connect to external PostgreSQL (e.g., Supabase, Neon, Docker)
# If omitted, application uses embedded local PGlite instance in .data/pglite
DATABASE_URL=

# YouTube Data API v3 Configuration
# Optional: Provide Google Cloud API Key for official YouTube Data API v3 queries
# If omitted or quota exhausted, mock/demo provider serves rich YouTube content seamlessly
YOUTUBE_API_KEY=

# Auth.js / Google OAuth Configuration
# Optional: Needed for logging into real YouTube account (subscriptions, playlists, liked videos)
AUTH_SECRET=changeme-generate-a-secure-random-32-byte-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Playback Provider Defaults
# Options: "html5" | "embed"
NEXT_PUBLIC_DEFAULT_PLAYBACK_PROVIDER=html5
