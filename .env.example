# ==============================================================================
# YouTube Web Client - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Optional: Set DATABASE_URL to connect to external PostgreSQL (e.g. Neon, Supabase, RDS)
# If omitted, application runs embedded PGlite (WASM Postgres) in .data/pglite with zero setup.
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. YouTube Data API v3 Configuration
# ------------------------------------------------------------------------------
# Optional: Provide Google Cloud API Key for official YouTube Data API v3 queries.
# If omitted or quota is exhausted, the client automatically retrieves real
# YouTube feeds, comments, and search results via public YouTube web integration!
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 3. Playback Engine Defaults
# ------------------------------------------------------------------------------
# Default playback engine: "html5" (Native HTML5 <video controls>) or "embed" (Official YouTube Player fallback)
NEXT_PUBLIC_DEFAULT_PLAYBACK_PROVIDER=html5
