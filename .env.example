# ==============================================================================
# YouTube Web Client - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# Optional: Set DATABASE_URL to connect to external PostgreSQL (e.g. Neon, Supabase, RDS)
# If omitted, application runs embedded PGlite (WASM Postgres) in .data/pglite with zero setup.
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. Google OAuth Configuration (Auth.js / NextAuth v5)
# ------------------------------------------------------------------------------
# Required ONLY if you want to sign in with your real Google/YouTube account to sync
# live subscriptions, private playlists, and liked videos.
#
# HOW TO CONFIGURE:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project (e.g. "YouTube Web Client").
# 3. Go to "APIs & Services" > "OAuth consent screen":
#    - Select "External" and configure your app name & email.
#    - Add scopes:
#        .../auth/userinfo.email
#        .../auth/userinfo.profile
#        .../auth/youtube.readonly
#        .../auth/youtube.force-ssl
# 4. Go to "APIs & Services" > "Credentials":
#    - Click "Create Credentials" -> "OAuth client ID".
#    - Select Application type: "Web application".
#    - Under "Authorized redirect URIs", add:
#        http://localhost:3000/api/auth/callback/google
# 5. Copy the Client ID and Client Secret below:
AUTH_SECRET=changeme-generate-a-secure-random-32-byte-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Note: You can also use standard alias names:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 3. YouTube Data API v3 Configuration
# ------------------------------------------------------------------------------
# Optional: Provide Google Cloud API Key for official YouTube Data API v3 queries.
# If omitted or quota (10,000 units/day) is exhausted, the client automatically
# retrieves real YouTube feeds and search results via its public YouTube integration!
YOUTUBE_API_KEY=

# ------------------------------------------------------------------------------
# 4. Playback Engine Defaults
# ------------------------------------------------------------------------------
# Default playback engine: "embed" (Official YouTube Player) or "html5" (Native HTML5 <video controls>)
NEXT_PUBLIC_DEFAULT_PLAYBACK_PROVIDER=embed
